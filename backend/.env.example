# Copia para .env e ajusta conforme necessario.
SECRET_KEY=dev-secret-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de dados PostgreSQL (bate com o docker-compose.yml)
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=reservas
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Origens permitidas para o frontend (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OAuth Google (opcional) — ID do cliente criado na Google Cloud Console.
# Deixar vazio desativa o login com Google. Tem de ser o MESMO id no frontend
# (VITE_GOOGLE_CLIENT_ID em .env.local na raiz).
GOOGLE_CLIENT_ID=
